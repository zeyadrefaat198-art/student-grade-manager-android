<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT MANAGER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#2563EB"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Grade Manager"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your student records easily"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="24dp"
            android:elevation="3dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL STUDENTS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#64748B"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvStudentCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Students: 0"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:gravity="center"
                android:paddingTop="12dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT MANAGEMENT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="14dp"/>

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="＋  Add Student"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnView"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="☷  View Students"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="⌕  Search Student"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✎  Update Student"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2563EB"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="✕  Delete Student"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#DC2626"/>

        <Button
            android:id="@+id/btnAverage"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="∑  Calculate Average"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#059669"/>

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ⓘ  About"
            android:textColor="#334155"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E2E8F0"/>

    </LinearLayout>
</ScrollView>